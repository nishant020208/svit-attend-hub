# SVIT Attend Hub - Environment Configuration
# Copy this file to .env or .env.local for local development

# Supabase Project URL (Required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Publishable API Key (Required)
# Accepts either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
